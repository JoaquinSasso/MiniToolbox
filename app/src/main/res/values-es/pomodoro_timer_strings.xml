    <string name="pomolist_help_title">Lista de timers Pomodoro</string>
    <string name="pomolist_help_p1">Crea perfiles con distintos tiempos de trabajo, descansos y ciclos antes del descanso largo.</string>
    <string name="pomolist_help_p3">Usa ✏️ para editar nombre, color y duraciones. Usa 🗑️ para eliminar el perfil.</string>
